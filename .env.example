# ── Tenant ────────────────────────────────────────────────────────────────
# Folder under data/ — switch this and the same agent becomes another company.
AGENT_TENANT=acme-telecom

# ── LLM (OpenRouter) ──────────────────────────────────────────────────────
# Get a key at https://openrouter.ai/keys — free tier is enough for demos.
OPENROUTER_API_KEY=
LLM_MODEL=cohere/north-mini-code:free
LLM_FALLBACK_MODEL=cohere/command-r7b-12-2024
# Point at a local Ollama/OpenAI-compatible server for private deployments:
# OPENROUTER_BASE_URL=http://localhost:11434/v1
# Or at the bundled fake LLM for offline dev (see README):
# OPENROUTER_BASE_URL=http://127.0.0.1:8123/api/v1   # make fake-llm
LLM_MAX_TOKENS=160
LLM_TEMPERATURE=0.4

# ── Speech-to-text (local, CPU) ───────────────────────────────────────────
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_THREADS=4

# ── Voice activity detection ──────────────────────────────────────────────
# silero (downloads a ~2 MB ONNX model) or energy (no download, noisier rooms)
VAD_BACKEND=silero
VAD_SILENCE_MS=650
VAD_MIN_SPEECH_MS=250
VAD_THRESHOLD=0.5

# ── Text-to-speech (local, CPU) ───────────────────────────────────────────
# Voice is downloaded on first run into voices/
TTS_VOICE=en_US-lessac-medium
TTS_SPEED=1.0
FILLER_DELAY_MS=800

# ── Retrieval ─────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_TOP_K=3
# Cosine similarity cutoff. Relevant chunks score ~0.67-0.85 with bge-small;
# unrelated ones ~0.45-0.65. Lower it if answers feel under-grounded.
RAG_MIN_SCORE=0.6

# ── Call memory ───────────────────────────────────────────────────────────
MAX_HISTORY_MESSAGES=8
SUMMARY_TRIGGER_MESSAGES=12

# ── Paths (defaults are fine) ─────────────────────────────────────────────
# DATA_DIR=./data
# DB_PATH=./data/calls.db
# VOICES_DIR=./voices
